---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import LedgerPlayer from "../components/LedgerPlayer.astro";
import CitePreview from "../components/CitePreview.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Owen Abel Amenze - Engineer, London",
  description = "Owen Abel Amenze is a senior software engineer in London. Explore work in event platforms, search, publishing, and reliable software.",
  noindex = false,
} = Astro.props;

const nav = [
  { href: "/", label: "Index" },
  { href: "/work", label: "Work" },
  { href: "/lab", label: "Lab" },
  { href: "/contact", label: "Contact" },
];

const pathname = Astro.url.pathname
  .replace(/\/index\.html$/, "/")
  .replace(/\.html$/, "")
  .replace(/\/$/, "") || "/";
const siteUrl = new URL("/", Astro.site ?? Astro.url).href;
const canonicalUrl = new URL(pathname, Astro.site ?? Astro.url).href;
const pageName = title.replace(/ - Owen Abel Amenze$/, "");
const personId = `${siteUrl}#person`;
const caseStudySlug = pathname.startsWith("/work/") ? pathname.slice("/work/".length) : undefined;
const ogImagePath = caseStudySlug ? `/og/${caseStudySlug}.png` : "/og.png";
const ogImage = new URL(ogImagePath, Astro.site ?? Astro.url).href;
const ogImageAlt = caseStudySlug
  ? `${pageName} case study by Owen Abel Amenze`
  : "Owen Abel Amenze, engineer in London";

const structuredDataGraph: Record<string, unknown>[] = [
  {
    "@type": "Person",
    "@id": personId,
    name: "Owen Abel Amenze",
    jobTitle: "Senior Software Engineer",
    url: siteUrl,
    image: ogImage,
    address: {
      "@type": "PostalAddress",
      addressLocality: "London",
      addressCountry: "GB",
    },
    sameAs: [
      "https://github.com/machineyearningengineer",
      "https://www.linkedin.com/in/owen-abel",
    ],
  },
];

if (pathname === "/") {
  structuredDataGraph.push({
    "@type": "WebSite",
    "@id": `${siteUrl}#website`,
    name: "Owen Abel Amenze",
    url: siteUrl,
    author: { "@id": personId },
  });
}

const section = ["work", "lab"].find((name) => pathname === `/${name}` || pathname.startsWith(`/${name}/`));
if (section) {
  const itemListElement = [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: section === "work" ? "Work" : "Lab",
      item: new URL(`/${section}`, siteUrl).href,
    },
  ];

  if (pathname.startsWith(`/${section}/`)) {
    itemListElement.push({
      "@type": "ListItem",
      position: 3,
      name: pageName,
      item: canonicalUrl,
    });

    structuredDataGraph.push({
      "@type": "CreativeWork",
      "@id": `${canonicalUrl}#creative-work`,
      name: pageName,
      description,
      url: canonicalUrl,
      author: { "@id": personId },
      mainEntityOfPage: canonicalUrl,
    });
  }

  structuredDataGraph.push({
    "@type": "BreadcrumbList",
    itemListElement,
  });
}

const structuredData = {
  "@context": "https://schema.org",
  "@graph": structuredDataGraph,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#efefec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111213" media="(prefers-color-scheme: dark)" />
    <style is:inline>
      html {
        background: #efefec;
        color: #11110f;
        color-scheme: light dark;
      }

      @media (prefers-color-scheme: dark) {
        html:not([data-theme="light"]) {
          background: #111213;
          color: #f3efe6;
          color-scheme: dark;
        }
      }

      html[data-theme="light"] {
        background: #efefec;
        color: #11110f;
        color-scheme: light;
      }

      html[data-theme="dark"] {
        background: #111213;
        color: #f3efe6;
        color-scheme: dark;
      }

      body {
        background-color: inherit;
      }
    </style>
    <script is:inline>
      (() => {
        const applyTheme = () => {
          try {
            const theme = localStorage.getItem("owenabel-theme");
            const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;

            if (theme === "light" || theme === "dark") {
              document.documentElement.dataset.theme = theme;
            } else if (prefersDark) {
              document.documentElement.dataset.theme = "dark";
            }
            // Browser bars and the overscroll area above and below the page use
            // theme-color: match the site's theme, not only the system's.
            const paper = document.documentElement.dataset.theme === "dark" ? "#111213" : "#efefec";
            document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => meta.setAttribute("content", paper));
          } catch {
            // Theme is progressive enhancement; default paper stays readable.
          }
        };
        applyTheme();
        // Client-side navigation swaps in the new page's <html> attributes; restore the theme.
        if (!window.__owenTheme) {
          window.__owenTheme = true;
          document.addEventListener("astro:after-swap", applyTheme);
        }
      })();
      // Homepage intro: first visit, or a week since it last played. Decided
      // before first paint so the page never flashes underneath it.
      (() => {
        try {
          if (location.pathname !== "/") return;
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          const last = Number(localStorage.getItem("owenabel-intro-at") || 0);
          if (Date.now() - last > 7 * 24 * 60 * 60 * 1000) {
            document.documentElement.dataset.intro = "play";
          }
        } catch {
          // No storage, no intro.
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Owen Abel Amenze" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg?v=4" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a
          class="brand"
          href="/"
          aria-label="Owen Abel Amenze home"
          aria-current={pathname === "/" ? "page" : undefined}
        >
          <strong>Owen Abel Amenze</strong>
          <span>Engineer / London</span>
        </a>
        <nav class="nav" aria-label="Primary navigation">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={pathname === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            aria-label="Use dark theme"
            aria-pressed="false"
          >
            ◐
          </button>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <div
          class="footer-microtext"
          aria-hidden="true"
          data-footer-microtext
        >
          according to all known laws of tasteful portfolio restraint there is no reason a tiny footer texture should contain this much honeyed administrative nonsense nevertheless the ledger continues invoice number wing-0001 line item soft landing line item improbable work ethic line item one small joke rendered almost invisible for quality assurance purposes please ignore this decorative transcript substitute it has no canonical relation to any animated feature film and exists only as a transparent paper grain for people who inspect too closely according to all known laws of tasteful portfolio restraint there is no reason a tiny footer texture should contain this much honeyed administrative nonsense nevertheless the ledger continues invoice number wing-0002 line item quiet systems line item calmer launches line item a barely readable joke hiding politely under the contact details
        </div>
        <span class="footer-links">
          <a href="/contact#book">Book a 20-minute intro</a>
          <span aria-hidden="true"> / </span>
          <a href="/owen-abel-amenze-cv.pdf?v=30e5ac5b65b2">CV</a>
        </span>
        <!--email_off-->
        <a href="mailto:hello@owenabel.com">hello@owenabel.com</a>
        <!--/email_off-->
      </footer>
    </div>
    <LedgerPlayer />
    <CitePreview />
    <script>
      import { onPage } from "../scripts/page";

      onPage((signal) => {
      const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const setTheme = (theme: string) => {
        const isDark = theme === "dark";

        document.documentElement.dataset.theme = isDark ? "dark" : "light";
        document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => meta.setAttribute("content", isDark ? "#111213" : "#efefec"));

        themeToggle?.setAttribute("aria-pressed", String(isDark));
        themeToggle?.setAttribute("aria-label", isDark ? "Use light theme" : "Use dark theme");
      };

      if (themeToggle) {
        setTheme(
          document.documentElement.dataset.theme ??
            (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"),
        );

        themeToggle.addEventListener("click", () => {
          const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";

          setTheme(nextTheme);
          try {
            localStorage.setItem("owenabel-theme", nextTheme);
          } catch {
            // Switching themes still works when preferences cannot be saved.
          }
        });
      }
      });
    </script>
    <!-- Cloudflare Web Analytics: page views and Core Web Vitals, no cookies, no
         personal data. spa:true counts client-side navigations. -->
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token: "494c1cb79c5b4086b2e0802035bfbd5e", spa: true })}
    ></script>
  </body>
</html>
