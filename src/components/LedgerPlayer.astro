---
// One site-wide audio player. It persists across client-side navigation, and
// any element with data-play="/path.mp3" (plus data-play-title and
// data-play-source) can take it over.
---

<aside
  class="ledger-player"
  data-player
  hidden
  aria-label="Now playing"
  transition:persist="ledger-player"
>
  <audio data-player-audio preload="none"></audio>
  <button type="button" class="ledger-player-toggle" data-player-toggle aria-label="Pause">
    <svg viewBox="0 0 12 12" aria-hidden="true" data-icon-pause>
      <rect x="2" y="1.5" width="2.6" height="9" fill="currentColor"></rect>
      <rect x="7.4" y="1.5" width="2.6" height="9" fill="currentColor"></rect>
    </svg>
    <svg viewBox="0 0 12 12" aria-hidden="true" data-icon-play>
      <path d="M3 1.5 10.5 6 3 10.5Z" fill="currentColor"></path>
    </svg>
  </button>
  <div class="ledger-player-meta">
    <span class="ledger-player-kicker">Now playing</span>
    <strong data-player-title></strong>
    <span data-player-source></span>
  </div>
  <span class="ledger-player-time" data-player-time>0:00</span>
  <button type="button" class="ledger-player-close" data-player-close aria-label="Close player">
    ×
  </button>
  <span class="ledger-player-track" aria-hidden="true"><span data-player-progress></span></span>
</aside>

<script>
  const player = document.querySelector<HTMLElement>("[data-player]");
  const audio = player?.querySelector<HTMLAudioElement>("[data-player-audio]");

  if (player && audio) {
    const title = player.querySelector<HTMLElement>("[data-player-title]");
    const source = player.querySelector<HTMLElement>("[data-player-source]");
    const time = player.querySelector<HTMLElement>("[data-player-time]");
    const progress = player.querySelector<HTMLElement>("[data-player-progress]");
    const toggle = player.querySelector<HTMLButtonElement>("[data-player-toggle]");

    const clock = (seconds: number) =>
      `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, "0")}`;

    const current = () => audio.getAttribute("src") ?? "";

    // Mark every trigger for the current track, including ones on newly swapped-in pages.
    const syncTriggers = () => {
      const playing = !audio.paused;
      for (const trigger of document.querySelectorAll<HTMLElement>("[data-play]")) {
        const active = trigger.dataset.play === current() && playing;
        trigger.toggleAttribute("data-playing", active);
        trigger.setAttribute("aria-pressed", String(active));
      }
    };

    const render = () => {
      const playing = !audio.paused;
      toggle?.setAttribute("aria-label", playing ? "Pause" : "Play");
      toggle?.toggleAttribute("data-paused", !playing);
      const duration = Number.isFinite(audio.duration) ? audio.duration : 0;
      if (time) time.textContent = duration ? `${clock(audio.currentTime)} / ${clock(duration)}` : "";
      if (progress) progress.style.transform = `scaleX(${duration ? audio.currentTime / duration : 0})`;
      syncTriggers();
    };

    const play = (trigger: HTMLElement) => {
      const src = trigger.dataset.play;
      if (!src) return;
      if (src === current()) {
        if (audio.paused) void audio.play();
        else audio.pause();
        return;
      }
      audio.src = src;
      if (title) title.textContent = trigger.dataset.playTitle ?? "";
      if (source) source.textContent = trigger.dataset.playSource ?? "";
      if ("mediaSession" in navigator) {
        navigator.mediaSession.metadata = new MediaMetadata({
          title: trigger.dataset.playTitle ?? "",
          artist: trigger.dataset.playSource ?? "",
        });
      }
      player.hidden = false;
      void audio.play();
    };

    document.addEventListener("click", (event) => {
      const trigger = event.target instanceof Element && event.target.closest<HTMLElement>("[data-play]");
      if (trigger) play(trigger);
    });
    toggle?.addEventListener("click", () => (audio.paused ? void audio.play() : audio.pause()));
    player.querySelector("[data-player-close]")?.addEventListener("click", () => {
      audio.pause();
      player.hidden = true;
    });
    for (const type of ["play", "pause", "timeupdate", "loadedmetadata", "ended"]) {
      audio.addEventListener(type, render);
    }
    document.addEventListener("astro:page-load", syncTriggers);
  }
</script>
