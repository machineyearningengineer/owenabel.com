---
// One Lab film with our own controls, in the same ledger style as the clips:
// play/pause, time, a scrubber with a square tick at each chapter start (the
// chapter title shows on hover or focus), sound (mute, plus a small volume
// slider where the pointer can hover), captions on/off and full screen.
// Tapping the picture plays or pauses. Chapters fold into one line naming the
// current chapter and open into the full list.
// Without JavaScript the browser's own controls are used instead.
// Keys while the player has focus: Space or K play/pause, ←/→ 5 s, M mute,
// C captions, F full screen; the scrubber also takes Page Up/Down by chapter.
import { MEDIA, type LabFilm } from "../data/lab";

interface Props {
  film: LabFilm;
}
const { film } = Astro.props;
const [minutes, seconds] = film.length.split(":").map(Number);
const total = minutes * 60 + seconds;
const clock = (t: number) => `${Math.floor(t / 60)}:${String(Math.floor(t % 60)).padStart(2, "0")}`;
const chapters = film.chapters ?? [];
---

<div class="film" data-film data-total={total}>
  <div class="film-frame">
    <video
      controls
      playsinline
      preload="none"
      crossorigin="anonymous"
      width="1280"
      height="720"
      poster={`${MEDIA}/${film.file}.jpg`}
      aria-label={film.title}
      data-film-video
    >
      <source src={`${MEDIA}/${film.file}.mp4`} type="video/mp4" />
      <track kind="captions" srclang="en" label="English" src={`${MEDIA}/${film.file}.vtt`} default />
      {chapters.length > 0 && <track kind="chapters" srclang="en" label="Chapters" src={`${MEDIA}/${film.file}.chapters.vtt`} />}
    </video>
  </div>

  <div class="film-bar" data-film-bar hidden>
    <button type="button" class="film-btn" data-film-play aria-label={`Play ${film.title}`}>
      <span aria-hidden="true" data-film-play-glyph>▶</span>
    </button>
    <span class="film-time" data-film-time>0:00 / {film.length}</span>
    <div class="film-scrub" data-film-scrub>
      <input
        type="range"
        class="journey-scrub"
        min="0"
        max={total}
        step="1"
        value="0"
        aria-label={`Scrub through ${film.title}`}
        data-film-range
      />
      <span class="film-ticks" aria-hidden="true">
        {chapters.slice(1).map(([at]) => (
          <i style={`--at: ${at / total}`} />
        ))}
      </span>
      <span class="film-tip" aria-hidden="true" data-film-tip hidden />
    </div>
    <div class="film-sound">
      <button type="button" class="film-btn" data-film-mute aria-label="Mute">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M2 6h3l4-3v10l-4-3H2z" fill="currentColor" />
          <path d="M11 5.5a3.5 3.5 0 0 1 0 5M12.8 3.6a6 6 0 0 1 0 8.8" fill="none" stroke="currentColor" stroke-width="1.3" data-film-waves />
          <path d="M11 6l4 4m0-4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" data-film-muted style="display: none" />
        </svg>
      </button>
      <input type="range" class="film-volume journey-scrub" min="0" max="1" step="0.05" value="1" aria-label="Volume" data-film-volume />
    </div>
    <button type="button" class="film-btn film-btn-text" data-film-cc aria-pressed="true" aria-label="CC captions">CC</button>
    <button type="button" class="film-btn" data-film-full aria-label="Full screen">
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4" fill="none" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </button>
  </div>

  <div class="lab-film-text">
    <h3>
      {film.title} <span>{film.length}</span>
    </h3>
    <p>{film.line}</p>
    {
      film.related && (
        <a href={film.related.href}>
          {film.related.label} <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>

  {
    chapters.length > 0 && (
      <details class="film-chapters-wrap" data-film-chapters>
        <summary>
          <span class="film-chapters-count">Chapters [{chapters.length}]</span>
          <span class="film-chapters-now" data-film-now>
            1 · {chapters[0][1]}
          </span>
        </summary>
        <ol class="film-chapters" aria-label={`Chapters of ${film.title}`}>
          {chapters.map(([at, title], index) => (
            <li>
              <button type="button" data-film-chapter={at} data-title={title} data-index={index + 1}>
                <span>{clock(at)}</span> {title}
              </button>
            </li>
          ))}
        </ol>
      </details>
    )
  }
</div>

<script>
  import { onPage } from "../scripts/page";
  import { touchScrub } from "../scripts/touch-scrub";

  const clock = (t: number) => `${Math.floor(t / 60)}:${String(Math.floor(t % 60)).padStart(2, "0")}`;

  onPage((signal) => {
    for (const root of document.querySelectorAll<HTMLElement>("[data-film]")) {
      const q = <T extends Element>(sel: string) => root.querySelector<T>(sel);
      const video = q<HTMLVideoElement>("[data-film-video]");
      const bar = q<HTMLElement>("[data-film-bar]");
      const play = q<HTMLButtonElement>("[data-film-play]");
      const glyph = q<HTMLElement>("[data-film-play-glyph]");
      const time = q<HTMLElement>("[data-film-time]");
      const scrub = q<HTMLElement>("[data-film-scrub]");
      const range = q<HTMLInputElement>("[data-film-range]");
      const tip = q<HTMLElement>("[data-film-tip]");
      const mute = q<HTMLButtonElement>("[data-film-mute]");
      const waves = q<SVGElement>("[data-film-waves]");
      const muted = q<SVGElement>("[data-film-muted]");
      const volume = q<HTMLInputElement>("[data-film-volume]");
      const cc = q<HTMLButtonElement>("[data-film-cc]");
      const full = q<HTMLButtonElement>("[data-film-full]");
      const now = q<HTMLElement>("[data-film-now]");
      if (!video || !bar || !play || !glyph || !time || !scrub || !range || !tip || !mute || !volume || !cc || !full) continue;

      // Our controls replace the browser's.
      video.controls = false;
      bar.hidden = false;
      const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-film-chapter]")];
      const starts = buttons.map((button) => Number(button.dataset.filmChapter));
      const titles = buttons.map((button) => button.dataset.title ?? "");
      const total = Number(root.dataset.total);
      const length = () => (Number.isFinite(video.duration) && video.duration > 0 ? video.duration : total);
      const chapterAt = (t: number) => (starts.length ? Math.max(0, starts.findLastIndex((start) => start <= t + 0.05)) : -1);
      let current = -2;

      const paint = () => {
        const t = video.currentTime;
        range.max = String(Math.round(length()));
        range.value = String(Math.round(t));
        range.style.setProperty("--played", `${(t / length()) * 100}%`);
        time.textContent = `${clock(t)} / ${clock(length())}`;
        const index = chapterAt(t);
        range.setAttribute("aria-valuetext", `${clock(t)} of ${clock(length())}${index >= 0 ? `, ${titles[index]}` : ""}`);
        if (index === current) return;
        current = index;
        if (now && index >= 0) now.textContent = `${index + 1} · ${titles[index]}`;
        buttons.forEach((button, i) => {
          if (i === index) button.setAttribute("aria-current", "true");
          else button.removeAttribute("aria-current");
        });
      };

      const playing = () => {
        const on = !video.paused;
        glyph.textContent = on ? "❚❚" : "▶";
        play.setAttribute("aria-label", `${on ? "Pause" : "Play"} ${video.getAttribute("aria-label")}`);
        root.toggleAttribute("data-playing", on);
      };
      const toggle = () => (video.paused ? video.play().catch(() => {}) : video.pause());

      // The film may not have loaded yet (preload="none"): load it, then seek.
      const seek = (t: number, andPlay = false) => {
        const go = () => {
          video.currentTime = Math.max(0, Math.min(t, length() - 0.1));
          paint();
          if (andPlay) video.play().catch(() => {});
        };
        if (video.readyState >= 1) return go();
        video.preload = "auto";
        video.addEventListener("loadedmetadata", go, { once: true, signal });
        video.load();
      };

      const show = (t: number) => {
        const index = chapterAt(t);
        tip.textContent = index >= 0 ? `${clock(t)} ${titles[index]}` : clock(t);
        const width = scrub.clientWidth;
        const x = 5 + (t / length()) * (width - 10);
        const half = tip.offsetWidth / 2;
        tip.style.left = `${Math.max(half, Math.min(width - half, x))}px`;
        tip.hidden = false;
      };
      const pointerTime = (event: PointerEvent) => {
        const box = range.getBoundingClientRect();
        return Math.max(0, Math.min(1, (event.clientX - box.left - 5) / (box.width - 10))) * length();
      };

      const sound = () => {
        const off = video.muted || video.volume === 0;
        if (waves) waves.style.display = off ? "none" : "";
        if (muted) muted.style.display = off ? "" : "none";
        mute.setAttribute("aria-label", off ? "Unmute" : "Mute");
        volume.value = String(video.muted ? 0 : video.volume);
        volume.style.setProperty("--played", `${Number(volume.value) * 100}%`);
      };
      const captions = () => video.textTracks && [...video.textTracks].find((track) => track.kind === "captions");
      const setCaptions = (on: boolean) => {
        const track = captions();
        if (track) track.mode = on ? "showing" : "hidden";
        cc.setAttribute("aria-pressed", String(on));
      };
      // Full screen keeps our controls: the whole player goes full screen.
      // iPhone Safari only lets the video itself go full screen, with Apple's controls.
      const fullscreen = () => {
        const frame = video as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
        if (document.fullscreenElement) return void document.exitFullscreen();
        if (root.requestFullscreen) root.requestFullscreen().catch(() => {});
        else frame.webkitEnterFullscreen?.();
      };
      document.addEventListener(
        "fullscreenchange",
        () => full.setAttribute("aria-label", document.fullscreenElement === root ? "Exit full screen" : "Full screen"),
        { signal },
      );

      play.addEventListener("click", toggle, { signal });
      video.addEventListener("click", toggle, { signal });
      for (const type of ["play", "pause", "ended"]) video.addEventListener(type, playing, { signal });
      for (const type of ["timeupdate", "seeked", "loadedmetadata", "durationchange"]) video.addEventListener(type, paint, { signal });
      video.addEventListener("volumechange", sound, { signal });

      range.addEventListener(
        "input",
        () => {
          seek(Number(range.value));
          if (document.activeElement === range) show(Number(range.value));
        },
        { signal },
      );
      touchScrub(range, signal);
      range.addEventListener(
        "keydown",
        (event) => {
          if (event.key !== "PageDown" && event.key !== "PageUp") return;
          event.preventDefault();
          if (!starts.length) return;
          const index = chapterAt(video.currentTime);
          const next =
            event.key === "PageDown"
              ? Math.min(index + 1, starts.length - 1)
              : Math.max(index - (video.currentTime - starts[index] > 2 ? 0 : 1), 0);
          seek(starts[next]);
          show(starts[next]);
        },
        { signal },
      );
      range.addEventListener("focus", () => range.matches(":focus-visible") && show(video.currentTime), { signal });
      range.addEventListener("blur", () => (tip.hidden = true), { signal });
      scrub.addEventListener("pointermove", (event) => show(pointerTime(event)), { signal });
      // A finger that starts a scroll on the scrubber is cancelled, with no leave in Safari.
      const leave = () => {
        if (range.matches(":focus-visible")) show(video.currentTime);
        else tip.hidden = true;
      };
      scrub.addEventListener("pointerleave", leave, { signal });
      scrub.addEventListener("pointercancel", leave, { signal });

      mute.addEventListener(
        "click",
        () => {
          video.muted = !video.muted;
          if (!video.muted && video.volume === 0) video.volume = 1;
        },
        { signal },
      );
      volume.addEventListener(
        "input",
        () => {
          video.volume = Number(volume.value);
          video.muted = video.volume === 0;
        },
        { signal },
      );
      cc.addEventListener("click", () => setCaptions(cc.getAttribute("aria-pressed") !== "true"), { signal });
      full.addEventListener("click", fullscreen, { signal });

      for (const [i, button] of buttons.entries()) {
        button.addEventListener("click", () => seek(starts[i], true), { signal });
      }

      // Keys while focus is anywhere in this player (not in the chapter list).
      root.addEventListener(
        "keydown",
        (event) => {
          if (event.metaKey || event.ctrlKey || event.altKey) return;
          const target = event.target as HTMLElement;
          if (target.closest("[data-film-chapters]")) return;
          const onRange = target === range || target === volume;
          const key = event.key.toLowerCase();
          if (key === " " || key === "k") {
            if (target.tagName === "BUTTON" && key === " ") return;
            event.preventDefault();
            toggle();
          } else if (!onRange && (key === "arrowleft" || key === "arrowright")) {
            event.preventDefault();
            seek(video.currentTime + (key === "arrowright" ? 5 : -5));
          } else if (key === "m") {
            video.muted = !video.muted;
          } else if (key === "c") {
            setCaptions(cc.getAttribute("aria-pressed") !== "true");
          } else if (key === "f") {
            fullscreen();
          }
        },
        { signal },
      );

      setCaptions(true);
      paint();
      playing();
      sound();
      signal.addEventListener("abort", () => video.pause());
    }
  });
</script>
