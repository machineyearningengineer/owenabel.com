<script>
  // Reading controls for story pages.
  // - Threads: [data-thread-control] buttons, number keys 1–9 and ←/→ jump to a
  //   step of the "How it works" journey from anywhere on the page; every
  //   [data-thread] node with that key is highlighted. Buttons are grouped per
  //   chapter ([data-thread-buttons]); the bar shows the group being read.
  // - Journey steps follow the scroll: the step on screen becomes the thread.
  // - ↑/↓ move between chapters ([data-case-section]); Escape clears.
  // - The chapter tree marks where you are and opens only that chapter's
  //   sub-chapters; the progress bar fills. A contents entry can point at a
  //   <details> (the architecture diagram): following it opens the disclosure.
  // - Desktop: the keys strip docks under the tree once its place under the
  //   hero scrolls away, and travels back when you return (FLIP, transform
  //   and opacity only; a crossfade with reduced motion).
  // - Share: copy the canonical URL or the build-time Markdown of the story.
  import { onPage } from "../scripts/page";

  onPage((signal) => {
    const caseNote = document.querySelector<HTMLElement>("[data-case-note]");
    if (!caseNote) return;

    const controls = [...caseNote.querySelectorAll<HTMLButtonElement>("[data-thread-control]")];
    const related = [...caseNote.querySelectorAll<HTMLElement>("[data-thread]")];
    const sections = [...caseNote.querySelectorAll<HTMLElement>("[data-case-section]")];
    const groupSections = [...caseNote.querySelectorAll<HTMLElement>("[data-thread-group]")];
    const buttonSets = [...caseNote.querySelectorAll<HTMLElement>("[data-thread-buttons]")];
    const steps = [...caseNote.querySelectorAll<HTMLElement>("[data-journey-step]")];
    const treeLinks = [...caseNote.querySelectorAll<HTMLAnchorElement>("[data-tree-link]")];
    const currentChapter = caseNote.querySelector<HTMLElement>("[data-current-chapter]");
    const mobileTree = caseNote.querySelector<HTMLDetailsElement>("[data-mobile-tree]");
    const progressBars = [...caseNote.querySelectorAll<HTMLElement>("[data-progress-bar]")];
    const progressValues = [...caseNote.querySelectorAll<HTMLElement>("[data-progress-value]")];
    const hints = [...caseNote.querySelectorAll<HTMLElement>("[data-thread-hint]")];
    const tree = caseNote.querySelector<HTMLElement>("[data-story-tree]");
    const subTrees = [...caseNote.querySelectorAll<HTMLElement>("[data-tree-sub]")];
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const anchorY = () => window.scrollY + window.innerHeight * 0.3;
    const top = (node: HTMLElement) => node.getBoundingClientRect().top + window.scrollY;

    // ---- Threads ----
    // The phone bar and the desktop strip both carry the step chips; use the one on screen.
    const groupControls = () => {
      const sets = buttonSets.filter((node) => node.dataset.threadButtons === caseNote.dataset.activeGroup);
      const set = sets.find((node) => node.getClientRects().length > 0) ?? sets[0];
      return set ? [...set.querySelectorAll<HTMLButtonElement>("[data-thread-control]")] : controls;
    };

    const chipSets = [...caseNote.querySelectorAll<HTMLElement>("[data-chip-group]")];
    const chips = [...caseNote.querySelectorAll<HTMLButtonElement>("[data-chip-target]")];
    let lastChip: string | undefined;
    chips.forEach((chip) =>
      chip.addEventListener(
        "click",
        () => document.getElementById(chip.dataset.chipTarget ?? "")?.scrollIntoView({ behavior: reduceMotion.matches ? "auto" : "smooth", block: "start" }),
        { signal },
      ),
    );

    // Phone bar: a newly reached step's chip opens to show its title for a
    // moment, then shrinks back to its number.
    let announceTimer = 0;
    let announcing = false;
    const announce = (key?: string) => {
      window.clearTimeout(announceTimer);
      caseNote.querySelectorAll(".story-control [data-announce]").forEach((node) => node.removeAttribute("data-announce"));
      if (!key || !announcing) return;
      const chip = caseNote.querySelector<HTMLElement>(`.story-control [data-chip-target="${key}"]`);
      if (!chip) return;
      chip.setAttribute("data-announce", "");
      announceTimer = window.setTimeout(() => chip.removeAttribute("data-announce"), 1800);
    };

    const applyThread = (key?: string) => {
      caseNote.dataset.activeThread = key ?? "";
      related.forEach((node) => node.toggleAttribute("data-active", Boolean(key) && node.dataset.thread === key));
      controls.forEach((control) => {
        const active = Boolean(key) && control.dataset.threadControl === key;
        control.toggleAttribute("data-active", active);
        control.setAttribute("aria-pressed", String(active));
      });
    };

    // The step to jump to: in the chapter being read if it has one, otherwise the
    // first chapter of this group, so a number or arrow works from anywhere.
    const stepFor = (key?: string) => {
      const inGroup = groupSections.filter((node) => node.dataset.threadGroup === caseNote.dataset.activeGroup);
      const section =
        inGroup.find((node) => node.contains(document.activeElement ?? null)) ??
        inGroup.filter((node) => top(node) <= anchorY()).pop() ??
        inGroup[0];
      return section?.querySelector<HTMLElement>(`[data-journey-step="${key}"]`);
    };

    // While a jump scrolls, the scroll-follow below must not re-pick the steps it passes.
    let followUntil = 0;
    const selectThread = (key?: string) => {
      applyThread(key);
      const step = key ? stepFor(key) : undefined;
      if (!step) return;
      followUntil = performance.now() + 1600;
      window.addEventListener("scrollend", () => (followUntil = 0), { once: true, signal });
      step.scrollIntoView({ behavior: reduceMotion.matches ? "auto" : "smooth", block: "start" });
    };

    const moveThread = (amount: number) => {
      const set = groupControls();
      const index = Math.max(0, set.findIndex((control) => control.dataset.threadControl === caseNote.dataset.activeThread));
      const next = set[(index + amount + set.length) % set.length];
      next.focus({ preventScroll: true });
      selectThread(next.dataset.threadControl);
    };

    controls.forEach((control) => {
      control.addEventListener("click", () => selectThread(control.dataset.threadControl));
      control.addEventListener("keydown", (event) => {
        if (!["ArrowRight", "ArrowLeft", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        event.stopPropagation();
        const set = groupControls();
        const index = set.indexOf(control);
        const next = {
          ArrowRight: set[(index + 1) % set.length],
          ArrowLeft: set[(index - 1 + set.length) % set.length],
          Home: set[0],
          End: set[set.length - 1],
        }[event.key as "ArrowRight" | "ArrowLeft" | "Home" | "End"];
        next.focus({ preventScroll: true });
        selectThread(next.dataset.threadControl);
      });
    });

    // Clicking a ledger row picks its thread (links inside still work).
    caseNote.querySelectorAll<HTMLElement>(".case-ledger tr[data-thread]").forEach((row) => {
      row.addEventListener("click", (event) => {
        if (event.target instanceof Element && event.target.closest("a, button")) return;
        applyThread(row.dataset.thread);
      });
    });

    // ---- Chapters ----
    const moveSection = (amount: number) => {
      const y = anchorY();
      let current = -1;
      sections.forEach((section, index) => {
        if (top(section) <= y) current = index;
      });
      if (amount < 0 && current <= 0) {
        window.scrollTo({ top: Math.max(0, top(caseNote) - 18), behavior: "auto" });
        return;
      }
      const next = Math.min(Math.max(current + amount, 0), sections.length - 1);
      sections[next].scrollIntoView({ behavior: "auto", block: "start" });
    };

    // A link or #hash to a closed <details> opens it, so it lands on the content.
    const openTarget = (hash: string) => {
      const id = decodeURIComponent(hash.slice(1));
      const target = id ? document.getElementById(id) : null;
      if (!(target instanceof HTMLDetailsElement) || !caseNote.contains(target)) return undefined;
      target.open = true;
      return target;
    };
    caseNote.addEventListener(
      "click",
      (event) => {
        const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href^="#"]') : null;
        if (link) openTarget(link.hash);
      },
      { signal },
    );
    window.addEventListener("hashchange", () => openTarget(location.hash), { signal });
    const landed = openTarget(location.hash);
    if (landed) requestAnimationFrame(() => landed.scrollIntoView({ block: "start" }));

    mobileTree?.querySelectorAll("a").forEach((link) =>
      link.addEventListener("click", () => {
        mobileTree.open = false;
      }),
    );

    // ---- Desktop keys strip: under the hero, or docked under the tree ----
    const strip = caseNote.querySelector<HTMLElement>("[data-keys]");
    const slot = caseNote.querySelector<HTMLElement>("[data-keys-slot]");
    const dock = caseNote.querySelector<HTMLElement>("[data-keys-dock]");
    const desktop = window.matchMedia("(min-width: 1000px)");
    let ghost: HTMLElement | undefined;

    const place = (docked: boolean, animate: boolean) => {
      if (!strip || !slot || !dock || strip.hasAttribute("data-docked") === docked) return;
      const focused = strip.contains(document.activeElement) ? (document.activeElement as HTMLElement) : null;
      const first = strip.getBoundingClientRect();
      ghost?.remove();
      ghost = animate && !reduceMotion.matches ? (strip.cloneNode(true) as HTMLElement) : undefined;
      // Hold the strip's place under the hero, so the prose never moves.
      if (docked) slot.style.minHeight = `${slot.offsetHeight}px`;
      (docked ? dock : slot).append(strip);
      strip.toggleAttribute("data-docked", docked);
      if (!docked) slot.style.minHeight = "";
      focused?.focus({ preventScroll: true });
      if (!animate) return;
      if (!ghost) {
        strip.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 160, easing: "ease-out" });
        return;
      }
      // FLIP: the old strip travels and shrinks into the new spot as it fades;
      // the new one sets off from the old spot and fades in. Transform and opacity only.
      const last = strip.getBoundingClientRect();
      const dx = last.left - first.left;
      const dy = last.top - first.top;
      const timing = { duration: 460, easing: "cubic-bezier(0.16, 1, 0.3, 1)" };
      ghost.removeAttribute("data-keys");
      ghost.querySelectorAll("[data-thread-control], [data-thread-buttons], [data-thread-hint]").forEach((node) => {
        node.removeAttribute("data-thread-control");
        node.removeAttribute("data-thread-buttons");
        node.removeAttribute("data-thread-hint");
      });
      ghost.setAttribute("aria-hidden", "true");
      ghost.inert = true;
      Object.assign(ghost.style, {
        position: "fixed",
        left: `${first.left}px`,
        top: `${first.top}px`,
        width: `${first.width}px`,
        margin: "0",
        zIndex: "5",
        pointerEvents: "none",
        transformOrigin: "top left",
      });
      caseNote.append(ghost);
      const leaving = ghost;
      leaving
        .animate(
          [
            { transform: "none", opacity: 1 },
            { transform: `translate(${dx}px, ${dy}px) scale(${last.width / first.width})`, opacity: 0 },
          ],
          timing,
        )
        .finished.catch(() => {})
        .finally(() => leaving.remove());
      strip.animate(
        [
          { transformOrigin: "top left", transform: `translate(${-dx}px, ${-dy}px) scale(${Math.min(1.25, first.height / last.height)})`, opacity: 0 },
          { transformOrigin: "top left", transform: "none", opacity: 1 },
        ],
        timing,
      );
    };

    // ---- Scroll: tree, group, step, keys strip, progress ----
    const chapters = treeLinks
      .map((link) => document.getElementById(link.dataset.treeLink ?? ""))
      .filter((node, index, list): node is HTMLElement => Boolean(node) && list.indexOf(node) === index);

    let frame = 0;
    let ready = false;
    const update = () => {
      frame = 0;
      const y = anchorY();

      // Dock the keys strip once its place under the hero is off the top (checked
      // every frame, so a jump past it, like a contents link, docks it too).
      if (slot) place(desktop.matches && slot.getBoundingClientRect().bottom < 0, ready);

      // By position on the page, since a contents entry (Architecture) can sit out of page order.
      const chapter =
        chapters
          .filter((node) => top(node) <= y)
          .sort((a, b) => top(a) - top(b))
          .pop() ?? chapters[0];
      treeLinks.forEach((link) => {
        const here = link.dataset.treeLink === chapter?.id;
        if (here) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
        link.toggleAttribute(
          "data-branch-active",
          !here && treeLinks.some((other) => other.dataset.treeLink === chapter?.id && other.dataset.treeParent === link.dataset.treeLink),
        );
      });
      const activeLink = treeLinks.find((link) => link.dataset.treeLink === chapter?.id);
      const openId = activeLink?.dataset.treeParent ?? chapter?.id;
      subTrees.forEach((sub) => sub.toggleAttribute("data-open", sub.dataset.treeSub === openId));
      // A step reads "3 · Games on the TV"; the [+N] count is left out.
      const nodes = [...(activeLink?.childNodes ?? [])].filter(
        (node) => !(node instanceof Element && node.classList.contains("story-tree-more")),
      );
      const step = nodes.find((node) => node instanceof Element && node.classList.contains("story-tree-n"));
      const text = nodes
        .filter((node) => node !== step)
        .map((node) => node.textContent)
        .join("")
        .trim();
      const label = step ? `${step.textContent} · ${text}` : text;
      if (currentChapter && label) currentChapter.textContent = label;

      // Phone bar chips: the folding section you're in, its current child lit.
      const groupId = activeLink?.dataset.treeParent ?? (chipSets.some((set) => set.dataset.chipGroup === activeLink?.dataset.treeLink) ? activeLink?.dataset.treeLink : undefined);
      chipSets.forEach((set) => (set.hidden = set.dataset.chipGroup !== groupId));
      caseNote.toggleAttribute("data-in-steps", Boolean(groupId));
      const childId = activeLink?.dataset.treeParent ? activeLink.dataset.treeLink : undefined;
      chips.forEach((chip) => {
        const on = chip.dataset.chipTarget === childId;
        chip.toggleAttribute("data-active", on);
        if (on) chip.setAttribute("aria-current", "location");
        else chip.removeAttribute("aria-current");
      });
      if (childId !== lastChip) {
        lastChip = childId;
        announce(childId);
      }

      const group = groupSections.filter((node) => top(node) <= y).pop()?.dataset.threadGroup ?? buttonSets[0]?.dataset.threadButtons;
      if (group && group !== caseNote.dataset.activeGroup) {
        caseNote.dataset.activeGroup = group;
        buttonSets.forEach((set) => (set.hidden = set.dataset.threadButtons !== group));
        hints.forEach((hint) => (hint.hidden = hint.dataset.threadHint !== group));
        const keys = groupControls().map((control) => control.dataset.threadControl);
        if (!keys.includes(caseNote.dataset.activeThread)) applyThread(keys[0]);
      }

      if (performance.now() > followUntil) {
        const step = steps.filter((node) => {
          const rect = node.getBoundingClientRect();
          return rect.top <= window.innerHeight * 0.45 && rect.bottom > window.innerHeight * 0.2;
        }).pop();
        if (step && step.dataset.journeyStep !== caseNote.dataset.activeThread) applyThread(step.dataset.journeyStep);
      }

      const start = top(caseNote);
      const span = Math.max(1, caseNote.offsetHeight - window.innerHeight);
      const share = Math.min(1, Math.max(0, (window.scrollY - start + window.innerHeight * 0.2) / span));
      const percent = `${Math.round(share * 100)}%`;
      progressBars.forEach((bar) => bar.style.setProperty("--progress", String(share)));
      progressValues.forEach((value) => (value.textContent = percent));
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    window.addEventListener("scroll", schedule, { passive: true, signal });
    window.addEventListener("resize", schedule, { signal });
    signal.addEventListener("abort", () => cancelAnimationFrame(frame));
    applyThread(caseNote.dataset.activeThread || undefined);
    // Collapse the tree without animating the first layout.
    tree?.setAttribute("data-collapsible", "");
    tree?.setAttribute("data-settling", "");
    update();
    ready = true;
    announcing = true;
    requestAnimationFrame(() => requestAnimationFrame(() => tree?.removeAttribute("data-settling")));

    desktop.addEventListener("change", () => place(desktop.matches && Boolean(slot && slot.getBoundingClientRect().bottom < 0), false), { signal });
    signal.addEventListener("abort", () => {
      ghost?.remove();
      window.clearTimeout(announceTimer);
    });

    // ---- Share ----
    const status = caseNote.querySelector<HTMLElement>("[data-copy-status]");
    const storyMarkdown = () => {
      const source = caseNote.querySelector("[data-story-markdown]")?.textContent;
      return source ? (JSON.parse(source) as string) : "";
    };
    caseNote.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      const label = button.textContent ?? "";
      let timer = 0;
      button.addEventListener("click", async () => {
        const value = button.dataset.copy === "markdown" ? storyMarkdown() : (button.dataset.copyValue ?? location.href);
        const copied = await navigator.clipboard?.writeText(value).then(
          () => true,
          () => false,
        );
        button.textContent = copied ? "Copied" : "Copy failed";
        button.toggleAttribute("data-copied", copied);
        if (status) status.textContent = copied ? `${label}: copied` : "Copy failed";
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          button.textContent = label;
          button.removeAttribute("data-copied");
        }, 1600);
      });
    });

    // ---- Keys ----
    document.addEventListener(
      "keydown",
      (event) => {
        if (event.defaultPrevented || event.metaKey || event.altKey || event.ctrlKey) return;
        if (!(event.target instanceof Node) || (!caseNote.contains(event.target) && event.target !== document.body)) return;
        if (event.target instanceof HTMLElement && event.target.closest("summary, video")) return;

        if (event.key === "ArrowDown") {
          event.preventDefault();
          moveSection(1);
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          moveSection(-1);
        } else if (event.key === "ArrowRight") {
          event.preventDefault();
          moveThread(1);
        } else if (event.key === "ArrowLeft") {
          event.preventDefault();
          moveThread(-1);
        } else if (/^[1-9]$/.test(event.key)) {
          event.preventDefault();
          selectThread(groupControls()[Number(event.key) - 1]?.dataset.threadControl);
        } else if (event.key === "Escape") {
          applyThread();
        }
      },
      { signal },
    );
  });
</script>
