---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getFeaturedWork } from "../data/work";

const cvHref = "/owen-abel-amenze-cv.pdf?v=6b188052ea8a";

const lineItems = [
  [
    "01",
    "Product systems",
    "Event search, maps and saved routes; ticketing, check-in and party games",
    "Next.js · TanStack Start · MapLibre",
  ],
  [
    "02",
    "Search & data",
    "Policy search on PostgreSQL in place of Elasticsearch; visual search that shows the evidence behind each result",
    "PostgreSQL · Go · ConnectRPC",
  ],
  [
    "03",
    "Reliability",
    "Led the Jisc website's move to AWS Fargate after scaling issues, with Terraform previews and release checks",
    "AWS ECS Fargate · Terraform",
  ],
];

const featuredWork = getFeaturedWork();
const exhibitMarks = ["A", "B", "C", "D"];
const built = new Date();
const builtLabel = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "Europe/London",
}).format(built);
const londonTime = new Intl.DateTimeFormat("en-GB", {
  hour: "2-digit",
  minute: "2-digit",
  timeZone: "Europe/London",
}).format(built);
---

<BaseLayout>
  <section class="hero" aria-labelledby="intro-title" data-ledger-surface>
    <canvas class="koi-pond" aria-hidden="true" data-koi-pond></canvas>
    <div class="hero-grid">
      <div class="identity">
        <h1 id="intro-title">Owen Abel Amenze</h1>
        <p>
          I'm a senior software engineer building products people use and the systems that keep them dependable, from search and data to live events.
        </p>
        <div class="hero-actions" aria-label="Primary actions">
          <a class="button-link" href="#selected-work">Selected work</a>
          <a class="button-link" href="/book">Book a 20-minute intro</a>
        </div>
      </div>

      <aside class="invoice-box" aria-label="At a glance">
        <dl>
          <dt>Document:</dt>
          <dd>INDEX-ABEL</dd>
          <dt>Updated:</dt>
          <dd><time datetime={built.toISOString()}>{builtLabel}</time></dd>
          <dt>London:</dt>
          <dd><span data-london-clock>{londonTime}</span></dd>
          <dt>Status:</dt>
          <dd class="status-open">Open to work</dd>
          <dt>Reach:</dt>
          <dd>54,295 views · Jun 2026</dd>
          <dt>Email:</dt>
          <dd class="invoice-email">
            <!--email_off-->
            <a href="mailto:work@owenabel.com">work@owenabel.com</a>
            <!--/email_off-->
            <button type="button" class="copy-email" data-copy-email="work@owenabel.com">
              Copy
            </button>
          </dd>
        </dl>
        <p class="invoice-hint" aria-hidden="true">Tap the paper.</p>
      </aside>
    </div>

    <div class="section">
      <table class="ledger">
        <caption>The kinds I work on</caption>
        <thead>
          <tr>
            <th scope="col">No.</th>
            <th scope="col">Area</th>
            <th scope="col">Shipped</th>
            <th scope="col">Stack</th>
          </tr>
        </thead>
        <tbody>
          {
            lineItems.map(([no, area, shipped, stack]) => (
              <tr>
                <td>{no}</td>
                <td>{area}</td>
                <td>{shipped}</td>
                <td>{stack}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <hr class="rule double-rule" />
    </div>
  </section>

  <section class="home-continuation" id="selected-work" aria-labelledby="selected-work-heading">
    <div class="section-header">
      <h2 id="selected-work-heading">Work</h2>
      <p>
        A few problems I've worked on, and the systems I built to solve them.
      </p>
    </div>

    <div class="work-list home-work-list">
      {
        featuredWork.map((item, index) => (
          <article class="work-item home-work-item">
            <span>{item.year}</span>
            <div>
              <h3>
                <a href={item.href}>{item.name}</a>
              </h3>
              <p>{item.detail}</p>
              <p class="work-stack">{item.stack}</p>
            </div>
            <span class="work-role">{item.role}</span>
            <a class="exhibit" href={item.href} tabindex="-1" aria-hidden="true">
              <img
                src={item.exhibit.src}
                alt=""
                width="960"
                height="600"
                loading="lazy"
                decoding="async"
              />
              <span>Exh. {exhibitMarks[index]}</span>
            </a>
          </article>
        ))
      }
    </div>

    <p class="continuation-link">
      <a href="/work">View the full work ledger</a>
    </p>
  </section>

  <section class="home-continuation" id="contact" aria-labelledby="home-contact-heading">
    <div class="section-header">
      <h2 id="home-contact-heading">Contact</h2>
      <p>Hit me up anytime.</p>
    </div>

    <div class="contact-panel home-contact-panel">
      <div class="contact-row">
        <span>Email</span>
        <!--email_off-->
        <a href="mailto:work@owenabel.com">work@owenabel.com</a>
        <!--/email_off-->
      </div>
      <div class="contact-row">
        <span>Links</span>
        <span>
          <a href="/book">Book a 20-minute intro</a>
          <span aria-hidden="true"> / </span>
          <a href="/contact">Contact page</a>
          <span aria-hidden="true"> / </span>
          <a href={cvHref}>CV</a>
        </span>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { mountKoiPond } from "../scripts/koi-pond";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-koi-pond]");
  const surface = document.querySelector<HTMLElement>("[data-ledger-surface]");
  if (canvas && surface) mountKoiPond(canvas, surface);

  const clock = document.querySelector<HTMLElement>("[data-london-clock]");
  const formatTime = new Intl.DateTimeFormat("en-GB", {
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    timeZone: "Europe/London",
  });
  const tickClock = () => {
    if (clock) clock.textContent = formatTime.format(new Date());
  };
  tickClock();
  setInterval(tickClock, 1000);

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-email]")) {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail ?? "");
        button.textContent = "Copied";
      } catch {
        button.textContent = "Select it";
      }
      setTimeout(() => (button.textContent = "Copy"), 1600);
    });
  }
</script>
