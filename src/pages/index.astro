---
import BaseLayout from "../layouts/BaseLayout.astro";
import Cite from "../components/Cite.astro";
import KoiPond from "../components/KoiPond.astro";
import HeadIntro from "../components/HeadIntro.astro";
import { getFeaturedWork } from "../data/work";

const featuredWork = getFeaturedWork();
const exhibitMarks = ["A", "B", "C", "D"];
const built = new Date();
const builtLabel = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "Europe/London",
}).format(built);
// "GMT" in winter, "BST" in summer (browsers disagree on the short name).
const londonZone =
  new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/London", timeZoneName: "longOffset" })
    .format(built)
    .includes("+01")
    ? "BST"
    : "GMT";
const londonTime = new Intl.DateTimeFormat("en-GB", {
  hour: "2-digit",
  minute: "2-digit",
  timeZone: "Europe/London",
}).format(built);
---

<BaseLayout>
  <HeadIntro />
  <section class="hero koi-surface" aria-labelledby="intro-title">
    <KoiPond />
    <h1 id="intro-title" class="visually-hidden">
      Owen Abel Amenze, engineer in London
    </h1>
    <div class="hero-grid">
      <table class="ledger">
        <caption>
          I&rsquo;m an engineer. That means I solve problems. What kind of problems?
          <button
            type="button"
            class="sound-cue"
            data-play="/audio/meet-the-engineer.mp3"
            data-play-title="Meet the Engineer"
            data-play-source="Team Fortress 2 · Valve"
            aria-label="Play the line this is from: Meet the Engineer, Team Fortress 2"
            aria-pressed="false"
          >
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M2.5 6h2.5l3.5-3v10l-3.5-3H2.5Z" fill="currentColor"></path>
              <path class="sound-wave sound-wave-1" d="M10.5 6.2a2.6 2.6 0 0 1 0 3.6"></path>
              <path class="sound-wave sound-wave-2" d="M12.2 4.5a5 5 0 0 1 0 7"></path>
            </svg>
          </button>
        </caption>
        <thead>
          <tr>
            <th scope="col">No.</th>
            <th scope="col">Area</th>
            <th scope="col">Shipped</th>
          </tr>
        </thead>
        <tbody>
          {
            <>
              <tr>
                <td>01</td>
                <td>Product systems</td>
                <td>
                  <Cite to="/work/fete-finder#how-it-works">Event search, maps and saved routes</Cite>;{" "}
                  <Cite to="/work/milk-and-henny#how-it-works">ticketing, check-in</Cite> and{" "}
                  <Cite to="/work/milk-and-henny#live-rooms">party games</Cite>
                </td>
              </tr>
              <tr>
                <td>02</td>
                <td>Search &amp; data</td>
                <td>
                  <Cite to="/work/open-policy-finder">Policy search on PostgreSQL</Cite> in place of
                  Elasticsearch;{" "}
                  <Cite to="/work/receipts#how-it-works">visual search</Cite> that shows the evidence
                  behind each result
                </td>
              </tr>
              <tr>
                <td>03</td>
                <td>Reliability</td>
                <td>
                  Led <Cite to="/work/jisc-website">the Jisc website's move to AWS Fargate</Cite> after
                  scaling issues, with Terraform previews and release checks
                </td>
              </tr>
            </>
          }
        </tbody>
      </table>

      <div class="index-card">
        <button
          type="button"
          class="owen-head"
          data-owen-head
          aria-label="My head. It follows your cursor; click to spin it."
        ></button>
        <aside class="invoice-box" aria-label="At a glance">
        <dl>
          <dt>Document:</dt>
          <dd>INDEX-ABEL</dd>
          <dt>Updated:</dt>
          <dd><time datetime={built.toISOString()}>{builtLabel}</time></dd>
          <dt>Local time:</dt>
          <dd><span data-london-clock>{londonTime}</span> · London, <span data-london-zone>{londonZone}</span></dd>
          <dt>Status:</dt>
          <dd class="status-open">Open to work</dd>
          <dt>Intro:</dt>
          <dd><a href="/contact#book">Book 20 minutes →</a></dd>
          <dt>Email:</dt>
          <dd class="invoice-email">
            <!--email_off-->
            <a href="mailto:hello@owenabel.com">hello@owenabel.com</a>
            <!--/email_off-->
            <button type="button" class="copy-email" data-copy-email="hello@owenabel.com">
              Copy
            </button>
          </dd>
        </dl>
        <p class="invoice-hint" aria-hidden="true">Tap the paper.</p>
      </aside>
      </div>
    </div>
  </section>

  <section class="home-continuation" id="selected-work" aria-labelledby="selected-work-heading">
    <div class="section-header">
      <h2 id="selected-work-heading">Work</h2>
      <p>The problem, what I built, and what happened.</p>
    </div>

    <div class="work-list home-work-list">
      {
        featuredWork.map((item, index) => (
          <article class="work-item home-work-item">
            <span>{item.year}</span>
            <div>
              <h3>
                <a href={item.href}>{item.name}</a>
              </h3>
              <p>{item.detail}</p>
            </div>
            <span class="work-role">{item.role}</span>
            <a class="exhibit" href={item.href} tabindex="-1" aria-hidden="true">
              <img
                src={item.exhibit.src}
                alt=""
                width="960"
                height="600"
                loading="lazy"
                decoding="async"
                style={`view-transition-name: exhibit-${item.href.split("/").pop()}`}
              />
              <span>Exh. {exhibitMarks[index]}</span>
            </a>
          </article>
        ))
      }
    </div>

    <p class="continuation-link">
      <a href="/work">View the full work ledger</a>
    </p>
  </section>
</BaseLayout>

<script>
  import { mountOwenHead } from "../scripts/owen-head";
  import { onPage } from "../scripts/page";

  onPage((signal) => {

    const head = document.querySelector<HTMLElement>("[data-owen-head]");
    if (head) mountOwenHead(head, signal);

  const clock = document.querySelector<HTMLElement>("[data-london-clock]");
  const zone = document.querySelector<HTMLElement>("[data-london-zone]");
  const offset = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Europe/London",
    timeZoneName: "longOffset",
  });
  const formatTime = new Intl.DateTimeFormat("en-GB", {
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    timeZone: "Europe/London",
  });
  const tickClock = () => {
    if (clock) clock.textContent = formatTime.format(new Date());
    if (zone) zone.textContent = offset.format(new Date()).includes("+01") ? "BST" : "GMT";
  };
  tickClock();
  const clockTimer = setInterval(tickClock, 1000);
  signal.addEventListener("abort", () => clearInterval(clockTimer));

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-email]")) {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail ?? "");
        button.textContent = "Copied";
      } catch {
        button.textContent = "Select it";
      }
      setTimeout(() => (button.textContent = "Copy"), 1600);
    });
  }
  });
</script>
