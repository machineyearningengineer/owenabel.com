---
import StoryLayout from "../../layouts/StoryLayout.astro";
import StoryChapter from "../../components/StoryChapter.astro";
import CaseJourney from "../../components/CaseJourney.astro";
import Clip from "../../components/Clip.astro";

const steps = [
  {
    key: "tickets",
    label: "Get a ticket",
    text: [
      "Each night has its own page with the timetable, the food and the tickets, sold through Stripe Checkout on the site itself. Guests sign in with a one-time email link and can add a passkey.",
      "Selling tickets myself, rather than through a ticketing platform, saves the platform's per-ticket fees and keeps me in direct contact with every guest. Their questions come to me, and I can see what's working before the night, not after.",
      "Before the night, an email tells each guest their team name and colour, and the QR code on their ticket comes framed in that colour. Amber, Sage, Plum or Sky.",
    ],
    clips: [
      { beat: "tickets", caption: "An event page, from the details down to the tickets." },
      { beat: "purchase", caption: "Choosing two tickets and filling in the guest's details, up to the payment button.", local: true },
      { beat: "teams", caption: "The host shuffles guests into four colour teams and sends the team cards.", local: true },
      { beat: "team-email", caption: "A guest's team email, with her ticket QR framed in Team Amber's colour.", local: true },
    ],
  },
  {
    key: "door",
    label: "Through the door",
    text: [
      "Staff scan the QR at the door. If the signal goes, the scanner keeps working offline, catches a ticket scanned twice on the same phone with a plain “Already scanned on this device”, and replays its queue when the signal comes back.",
    ],
    clips: [
      { beat: "door-scan", caption: "The door scanner reads a guest's QR through the camera and checks her in.", local: true },
      { beat: "door-offline", caption: "With no signal, a guest is let in from the downloaded list, and a second scan of the same ticket is refused.", local: true },
      { beat: "door-sync", caption: "Back online, the scanner replays its two offline check-ins and the guest list shows them inside.", local: true },
    ],
  },
  {
    key: "games",
    label: "Games on the TV",
    text: [
      "The games run on the venue's screen, with phones as controllers. In Family Feud the TV shows the board and a one-use QR code, and the MC's phone becomes the host controller, with the answers the room can't see yet.",
      "There are a dozen games on the shelf, from Mafia and Imposter to a spelling bee, plus an icebreaker that reveals your event colour and helps you meet someone new.",
    ],
    clips: [
      { beat: "games", caption: "Family Feud's setup: the board goes on this screen, and the TV shows a one-use QR code for the MC's phone." },
      { beat: "games-controller", caption: "With the MC's phone paired, the game starts from the phone.", local: true },
    ],
  },
  {
    key: "hot-and-cold",
    label: "Hot & Cold",
    text: [
      "Hot & Cold is my favourite of the games. There's a hidden word, and every guess gets a number: how many words in the dictionary sit closer to it in meaning. Zero finds it.",
      "The number does the teaching. Nobody needs the rules twice when “castle” comes back #410 and “sea” comes back #4. The screen warms as you close in.",
      "There's a new word every day at midnight, London time, with unlimited guesses and three hints. A room can also play it on their phones, taking turns. Whoever finds the word, or gets closest, wins the round.",
    ],
    clips: [
      { beat: "hot-and-cold", caption: "Five guesses at the daily word, from “tree” at #11,742 to “mermaid” at #0.", local: true },
      { beat: "hot-and-cold-standing", caption: "The result page, then how the solve compares with everyone else who played that word.", local: true },
      { beat: "hot-and-cold-room", caption: "Two phones in a room take turns: house, song, piano, then Kofi finds “guitar”.", local: true },
    ],
  },
  {
    key: "pitch-night",
    label: "Pitch Night",
    text: [
      "Pitch Night is the part of the evening where you take the mic and try to convince a room of strangers. A bad business idea, an unpopular opinion, or the conspiracy theory you've been sitting on for years.",
      "The site's own pitch: “Bring a pitch, an unpopular opinion, or a conspiracy theory. We'll give it a mic, a projector, and a room ready to be convinced.” After that, it promises, everyone will “dance until the room forgets it had chairs.”",
    ],
    caption: "The Pitch Night page for After School Club.",
  },
  {
    key: "studio",
    label: "Build your slides early",
    text: [
      "Nobody wants to make slides at a party, so guests make them before. Pitch Night Studio gives you six slides, and publishing seals them into a public snapshot.",
      "On the night the host puts the deck on the big screen. The presenter scans a QR code, the host lets them in, and they move through their slides from their own phone.",
    ],
    clips: [
      { beat: "studio-edit", caption: "Editing a slide in Pitch Night Studio: a new title, some text and a shape.", local: true },
      { beat: "studio", caption: "The wall of published pitches, then one of them." },
    ],
  },
  {
    key: "photos",
    label: "The photos",
    text: [
      "Afterwards the photos go up as albums. Browsing uses smaller images prepared in advance. Downloading an original checks that the album is published, then hands out a signed link.",
      "Not everything belongs in a public album. For the rest I built my own file transfer: pick the files, choose how long the link lives, from 30 minutes to 30 days, and send it. The page counts down, and when it ends the files go. After a night, guests can add theirs from a QR on the wall.",
    ],
    clips: [
      { beat: "photos", caption: "Opening an album, then one of its photos." },
      { beat: "transfer-create", caption: "Creating a transfer: a title, a 14-day expiry and six files, then a share link and a private owner link.", local: true },
