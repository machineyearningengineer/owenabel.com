---
import BaseLayout from "../../layouts/BaseLayout.astro";

const exhibits = [
  ["/exhibits/fete-recap.webp", "Fête Finder recap: the paper map of the night", "/work/fete-finder-discovery"],
  ["/exhibits/fete-story.webp", "Fête Finder recap: the 2026 numbers", "/work/fete-finder-discovery"],
  ["/exhibits/fete-event.webp", "Fête Finder event card with genre tags", "/work/fete-finder-discovery"],
  ["/exhibits/fete-event-phone.webp", "Fête Finder event on a phone", "/work/fete-finder-discovery"],
  ["/exhibits/fete-archive.webp", "Fête Finder archive of Paris events", "/work/fete-finder-operations"],
  ["/exhibits/fete-recap-dark.webp", "Fête Finder recap in dark mode", "/work/fete-finder-discovery"],
  ["/exhibits/milk-pitch.webp", "Milk & Henny Pitch Night event page", "/work/milk-and-henny-operations"],
  ["/exhibits/milk-pitch-phone.webp", "Milk & Henny Pitch Night on a phone", "/work/milk-and-henny-operations"],
  ["/exhibits/milk-event.webp", "Milk & Henny event page with tickets", "/work/milk-and-henny-operations"],
  ["/exhibits/milk-event-waitlist.webp", "Milk & Henny sold-out waitlist", "/work/milk-and-henny-operations"],
  ["/exhibits/milk-event-phone.webp", "Milk & Henny event on a phone", "/work/milk-and-henny-operations"],
  ["/exhibits/milk-things.webp", "Milk & Henny games and tools", "/work/milk-and-henny-games"],
  ["/exhibits/milk-pics.webp", "Milk & Henny photo galleries", "/work/milk-and-henny-media"],
  ["/exhibits/opf-home.webp", "Open Policy Finder search", "/work/open-policy-finder"],
  ["/exhibits/opf-updates.webp", "Open Policy Finder updates", "/work/open-policy-finder"],
  ["/exhibits/opf-phone.webp", "Open Policy Finder on a phone", "/work/open-policy-finder"],
  ["/exhibits/receipts-feed.webp", "Receipts discovery feed", "/work/receipts-discovery"],
  ["/exhibits/receipts-photo-search.webp", "Receipts search by photo", "/work/receipts-discovery"],
  ["/exhibits/receipts-about.webp", "Receipts: why it exists", "/work/receipts-discovery"],
  ["/exhibits/receipts-phone.webp", "Receipts on a phone", "/work/receipts-discovery"],
  ["/exhibits/receipts-about-phone.webp", "Receipts about page on a phone", "/work/receipts-platform"],
];
---

<BaseLayout
  title="Exhibit room - Owen Abel Amenze"
  description="A test room: scroll through screens from the products Owen Abel Amenze has built."
  noindex
>
  <section class="wormhole-intro" aria-labelledby="wormhole-title">
    <p class="eyebrow">Lab / test</p>
    <h1 id="wormhole-title">Exhibit room</h1>
    <p>Scroll to travel through every screen in the ledger. Click one to open its case study.</p>
  </section>

  <div data-wormhole>
  <section class="wormhole" aria-hidden="true">
    <div class="wormhole-stage" data-wormhole-stage>
      <div class="wormhole-tube" data-wormhole-tube></div>
      <p class="wormhole-caption">Keep scrolling</p>
    </div>
  </section>
  <section class="wormhole-list" aria-labelledby="exhibit-list-title">
    <h2 id="exhibit-list-title">All exhibits</h2>
    <ul class="wormhole-index">
      {
        exhibits.map(([src, label, href]) => (
          <li>
            <a href={href} data-exhibit>
              <img src={src} alt="" loading="eager" decoding="async" />
              <span>{label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  </div>
</BaseLayout>

<script>
  import { mountWormhole } from "../../scripts/wormhole";

  const section = document.querySelector<HTMLElement>("[data-wormhole]");
  if (section) mountWormhole(section);
</script>

<style>
  .wormhole-intro {
    max-width: 640px;
    padding-bottom: 48px;
  }

  .wormhole-intro h1 {
    margin: 4px 0 12px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(44px, 7vw, 84px);
    font-weight: 400;
    line-height: 0.95;
  }

  .wormhole-intro p:last-child {
    color: var(--muted);
  }

  .wormhole {
    position: relative;
    height: 520vh;
    margin-inline: calc(50% - 50vw);
  }

  .wormhole-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    background: radial-gradient(circle at 50% 50%, #050506 0 8%, #0d0d0f 40%, #000 100%);
  }

  .wormhole-tube {
    position: absolute;
    top: 50%;
    left: 50%;
    transform-style: preserve-3d;
  }

  .wormhole-tube :global(.wormhole-ring) {
    position: absolute;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .wormhole-tube :global(.wormhole-tile) {
    position: absolute;
    width: var(--tile-w);
    height: var(--tile-d);
    margin: calc(var(--tile-d) / -2) 0 0 calc(var(--tile-w) / -2);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #111;
    transform: rotateZ(var(--angle)) translateY(var(--radius)) rotateX(90deg);
    backface-visibility: visible;
    opacity: var(--fade, 1);
  }

  .wormhole-tube :global(.wormhole-tile img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .wormhole-tube :global(.wormhole-tile[data-flip] img) {
    transform: rotate(180deg);
  }

  .wormhole-tube :global(.wormhole-tile:hover) {
    outline: 2px solid #f0a36d;
    outline-offset: -2px;
  }

  .wormhole-caption {
    position: absolute;
    bottom: 24px;
    left: 50%;
    margin: 0;
    color: rgba(255, 255, 255, 0.5);
    font-size: 11px;
    text-transform: uppercase;
    transform: translateX(-50%);
  }

  .wormhole-list h2 {
    margin: 48px 0 16px;
    font-size: 15px;
    font-weight: 500;
    text-transform: uppercase;
  }

  .wormhole-index {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wormhole-index a {
    text-decoration: none;
  }

  .wormhole-index img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--rule);
  }

  .wormhole-index span {
    display: block;
    margin-top: 6px;
    color: var(--muted);
    font-size: 12px;
  }

  /* Reduced motion: no tunnel, the grid below is the room. */
  [data-mode="still"] .wormhole {
    display: none;
  }
</style>
