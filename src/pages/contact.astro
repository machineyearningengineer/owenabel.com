---
import BaseLayout from "../layouts/BaseLayout.astro";
import KoiPond from "../components/KoiPond.astro";

const bookingUrl =
  "https://calendar.google.com/calendar/appointments/schedules/AcZssZ2LQPawHeYUD3HNEFUuFDr-0CUsi7Z8B9m-peU3KF5hTYbjP6SONeHbBNAb57dCOcX3lob_WBS1?gv=true";
---

<BaseLayout
  title="Contact - Owen Abel Amenze"
  description="Email Owen Abel Amenze or book a 20-minute introductory chat on Google Meet."
>
  <div class="koi-surface koi-band">
    <KoiPond fish={2} />
    <h1 class="page-title">Got a problem in mind?</h1>
  </div>

  <section class="contact-panel" aria-label="Contact details">
    <div class="contact-row">
      <span>Email</span>
      <!--email_off-->
      <span class="contact-value">
        <a href="mailto:hello@owenabel.com">hello@owenabel.com</a>
        <button
          class="copy-button"
          type="button"
          data-copy-email="hello@owenabel.com"
          aria-label="Copy work email"
        >
          Copy
        </button>
        <span class="copy-status" data-copy-status aria-live="polite"></span>
      </span>
      <!--/email_off-->
    </div>
    <div class="contact-row">
      <span>GitHub</span>
      <a href="https://github.com/machineyearningengineer">github.com/machineyearningengineer</a>
    </div>
    <div class="contact-row">
      <span>LinkedIn</span>
      <a href="https://www.linkedin.com/in/owen-abel">linkedin.com/in/owen-abel</a>
    </div>
    <div class="contact-row">
      <span>CV</span>
      <a href="/owen-abel-amenze-cv.pdf?v=6b188052ea8a">Download PDF</a>
    </div>
  </section>

  <section class="booking" id="book" aria-labelledby="booking-title">
    <div class="section-header">
      <h2 id="booking-title">Book a chat</h2>
      <p>
        20 minutes on Google Meet. Pick a time below, or{" "}
        <a href={bookingUrl} target="_blank" rel="noopener noreferrer">open Google Calendar</a>.
      </p>
    </div>
    <div class="booking-embed">
      <iframe
        src={bookingUrl}
        title="Google Calendar booking page for a 20-minute introductory chat"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
  </section>

  <script>
    import { onPage } from "../scripts/page";

    onPage(() => {
      const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-email]");
      const copyStatus = document.querySelector("[data-copy-status]");
      if (!copyButton || !copyStatus) return;

      copyButton.addEventListener("click", async () => {
        const email = copyButton.dataset.copyEmail;
        if (!email) return;
        try {
          await navigator.clipboard.writeText(email);
          copyButton.textContent = "Copied";
          copyStatus.textContent = "Email copied.";
          window.setTimeout(() => {
            copyButton.textContent = "Copy";
            copyStatus.textContent = "";
          }, 1800);
        } catch {
          copyStatus.textContent = "Copy failed.";
        }
      });
    });
  </script>
</BaseLayout>
