---
import BaseLayout from "../layouts/BaseLayout.astro";
import KoiPond from "../components/KoiPond.astro";
import { exhibitMark, work } from "../data/work";
import { readMinutes } from "../lib/read-minutes";

const minutes = await readMinutes();
// One entry per story page; the hook's first sentence is the line.
const entries = work.flatMap((item) =>
  item.caseNotes.map((note) => ({
    ...note,
    year: item.year,
    line: note.summary.split(/(?<=[.!?])\s+(?=[A-Z])/)[0],
    mark: exhibitMark(note.href),
    minutes: minutes[note.href],
    slug: note.href.split("/").pop(),
  })),
);
const count = ["No", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine"][entries.length] ?? entries.length;
---

<BaseLayout
  title="Work - Owen Abel Amenze"
  description="Selected software engineering work by Owen Abel Amenze."
>
  <section class="section-header koi-surface koi-band" aria-labelledby="work-heading">
    <KoiPond fish={3} />
    <h1 id="work-heading">Work</h1>
    <p>{count} projects: the problem, what I built, and how it went.</p>
  </section>

  <ol class="work-list work-entries">
    {
      entries.map((entry) => (
        <li class="work-entry">
          <a href={entry.href}>
            <span class="work-entry-year">{entry.year}</span>
            <div class="work-entry-body">
              <div class="work-entry-head">
                <h2>{entry.label}</h2>
                <span class="work-entry-role">{entry.role}</span>
              </div>
              <p class="work-entry-line">{entry.line}</p>
              <p class="work-entry-fact">{entry.fact}</p>
              <ul class="stack-tags" aria-label="Stack">
                {entry.stack.map((tool) => (
                  <li>{tool}</li>
                ))}
              </ul>
              <span class="work-entry-read">
                Read · {entry.minutes} min <span aria-hidden="true">→</span>
              </span>
            </div>
            <span class="exhibit work-entry-exhibit" aria-hidden="true">
              <img
                src={entry.exhibit.src}
                alt=""
                width="960"
                height="600"
                loading="lazy"
                decoding="async"
                style={`view-transition-name: exhibit-${entry.slug}`}
              />
              <span>Exh. {entry.mark}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</BaseLayout>
