{
  "name": "owenabel.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:raw": "astro dev",
    "og:generate": "node scripts/generate-og.mjs",
    "prebuild": "pnpm run og:generate",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings . --ignore-pattern dist --ignore-pattern node_modules --ignore-pattern '*.astro'",
    "typecheck": "astro check && tsgo --noEmit",
    "build": "pnpm run build:site && pnpm run build:workers",
    "preview": "astro preview",
    "deploy:cf": "node scripts/deploy-workers.mjs",
    "cf:auth": "cf auth whoami",
    "cf:project": "env -u CLOUDFLARE_API_TOKEN cf workers deployments list --worker owenabel-com --profile default",
    "test:deploy": "node --test scripts/deploy-workers.test.mjs",
    "build:site": "pnpm run format:check && pnpm run lint && pnpm run typecheck && astro build && node scripts/check-prose.mjs && node scripts/generate-redirects.mjs",
    "build:workers": "pnpm --dir workers run build && node scripts/validate-workers.mjs",
    "preview:workers": "pnpm --dir workers exec vite preview --port 8788 --strictPort",
    "dev:workers": "pnpm --dir workers exec cf dev",
    "test:routing": "pnpm --dir workers exec node test-routing.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "head:build": "node scripts/build-head-sprite.mjs",
    "check:prose": "node scripts/check-prose.mjs",
    "media:sync": "node scripts/media-sync.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.3",
    "@typescript/native-preview": "7.0.0-dev.20260512.1",
    "astro": "7.0.7",
    "cf": "1.0.0-beta.5",
    "oxfmt": "0.49.0",
    "oxlint": "1.64.0",
    "oxlint-tsgolint": "0.22.1",
    "sharp": "0.34.5",
    "typescript": "6.0.3",
    "ultrahtml": "1.6.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.17.0"
}
