{
  "ref": "portfolio_force_https",
  "description": "Preserve portfolio HTTPS redirects after Pages to Workers migration",
  "expression": "(http.host in {\"owenabel.com\" \"www.owenabel.com\"} and not ssl)",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 301,
      "target_url": {
        "expression": "concat(\"https://\", http.host, http.request.uri.path)"
      },
      "preserve_query_string": true
    }
  },
  "enabled": true
}
